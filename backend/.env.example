# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/food_inventory

# JWT Keys
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100